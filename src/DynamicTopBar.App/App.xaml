<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DynamicTopBar.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Design tokens from UX_SPEC.md & Visual Direction -->
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#090909" />
            <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#171717" />
            <SolidColorBrush x:Key="OverlayBorderBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="OverlayTextPrimaryBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="OverlayTextSecondaryBrush" Color="#A7A7A7" />
            <SolidColorBrush x:Key="OverlayTextTertiaryBrush" Color="#666666" />
            <SolidColorBrush x:Key="OverlayAccentBrush" Color="#00B4FF" />
            <SolidColorBrush x:Key="OverlayControlHoverBrush" Color="#222222" />
            <SolidColorBrush x:Key="OverlayControlPressedBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="OverlayProgressBackgroundBrush" Color="#262626" />

            <!-- Sizing Tokens -->
            <x:Double x:Key="BarIdleHeight">44.0</x:Double>
            <x:Double x:Key="BarIdleWidth">340.0</x:Double>
            <x:Double x:Key="BarExpandedWidth">376.0</x:Double>
            <x:Double x:Key="BarExpandedHeight">224.0</x:Double>
            <CornerRadius x:Key="BarCornerRadius">22</CornerRadius>
            <CornerRadius x:Key="AlbumArtCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="ChipCornerRadius">12</CornerRadius>
            <Thickness x:Key="PanelPadding">16</Thickness>

            <!-- Typography Tokens -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
            <x:Double x:Key="TitleFontSize">15.0</x:Double>
            <x:Double x:Key="BodyFontSize">12.0</x:Double>
            <x:Double x:Key="CaptionFontSize">11.0</x:Double>
            <x:Double x:Key="ChipFontSize">11.0</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
