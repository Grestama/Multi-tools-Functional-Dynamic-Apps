                                <Button x:Name="FocusPreset50mButton"
                                        Content="50m Deep"
                                        FontSize="11"
                                        Padding="10,4,10,4"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Click="OnFocusPreset50mClick"
                                        ToolTipService.ToolTip="50 min deep work session"
                                        AutomationProperties.Name="50 minute deep work preset" />
