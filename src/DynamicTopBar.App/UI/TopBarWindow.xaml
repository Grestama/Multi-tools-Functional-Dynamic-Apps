                                <Button x:Name="FocusPreset5mButton"
                                        Content="5m Break"
                                        FontSize="11"
                                        Padding="10,4,10,4"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Click="OnFocusPreset5mClick"
