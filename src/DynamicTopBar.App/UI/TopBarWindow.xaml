                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE7C1;"
                                              FontSize="11"
                                              Foreground="{StaticResource OverlayAccentBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <TextBlock x:Name="StopwatchLapsSummaryText"
