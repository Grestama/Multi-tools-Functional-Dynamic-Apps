                        </Grid>

                        <!-- Feature 3: Quick Launch (Fully Functional MVP Module) -->
                        <Grid x:Name="QuickLaunchContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Shortcut Tiles Grid (3 Columns x 2 Rows) -->
