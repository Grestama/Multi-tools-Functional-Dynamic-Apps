                                <Button x:Name="FocusPreset25mButton"
                                        Content="25m Work"
                                        FontSize="11"
                                        Padding="10,4,10,4"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Click="OnFocusPreset25mClick"
