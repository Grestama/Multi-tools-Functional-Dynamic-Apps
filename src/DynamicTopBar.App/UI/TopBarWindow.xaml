<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DynamicTopBar.App.UI.TopBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DynamicTopBar.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DynamicTopBar"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerEntered="OnRootPointerEntered"
          PointerExited="OnRootPointerExited"
          KeyDown="OnRootKeyDown">

        <Grid.Resources>
            <!-- Animation: Smooth Downward Expansion & Fluid Morphing -->
            <Storyboard x:Name="ExpandStoryboard">
                <DoubleAnimation Storyboard.TargetName="ExpandedPanelGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 To="1.0"
                                 Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ExpandedPanelTransform"
                                 Storyboard.TargetProperty="Y"
                                 To="0.0"
                                 Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Animation: Smooth Collapse Fade & Fluid Demorphing -->
            <Storyboard x:Name="CollapseStoryboard">
                <DoubleAnimation Storyboard.TargetName="ExpandedPanelGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0.0"
                                 Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ExpandedPanelTransform"
                                 Storyboard.TargetProperty="Y"
                                 To="-12.0"
                                 Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Animation: Slide Down Reveal from Top Edge -->
            <Storyboard x:Name="SlideDownStoryboard">
                <DoubleAnimation Storyboard.TargetName="MainContainer"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.0"
                                 To="1.0"
                                 Duration="0:0:0.24">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MainContainerTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="-22.0"
                                 To="0.0"
                                 Duration="0:0:0.24">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Animation: Slide Up Conceal to Top Edge -->
            <Storyboard x:Name="SlideUpStoryboard">
                <DoubleAnimation Storyboard.TargetName="MainContainer"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1.0"
                                 To="0.0"
                                 Duration="0:0:0.20">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MainContainerTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="0.0"
                                 To="-22.0"
                                 Duration="0:0:0.20">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Animation: 3-Bar Audio Equalizer Wave GPU Animation -->
            <Storyboard x:Name="WaveStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="WaveBar1Transform"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="0.3" To="1.0"
                                 AutoReverse="True"
                                 Duration="0:0:0.35" />
                <DoubleAnimation Storyboard.TargetName="WaveBar2Transform"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="1.0" To="0.35"
                                 AutoReverse="True"
                                 Duration="0:0:0.42" />
                <DoubleAnimation Storyboard.TargetName="WaveBar3Transform"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="0.4" To="0.9"
                                 AutoReverse="True"
                                 Duration="0:0:0.30" />
            </Storyboard>
        </Grid.Resources>

        <!-- Top Trigger Notch Handle ("Garis Button") -->
        <!-- Visible when the top bar is concealed in Auto-Hide mode at the top edge -->
        <Border x:Name="TopTriggerHandle"
                Width="80"
                Height="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0"
                CornerRadius="2.5"
                Background="{StaticResource OverlayAccentBrush}"
                Opacity="0.9"
                PointerEntered="OnTriggerHandlePointerEntered"
                PointerExited="OnTriggerHandlePointerExited"
                Tapped="OnTriggerHandleTapped"
                ToolTipService.ToolTip="Dekatkan kursor ke sini untuk membuka DynamicTopBar"
                AutomationProperties.Name="Buka DynamicTopBar"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TriggerHandleTransform" Y="0" />
            </Border.RenderTransform>
        </Border>

        <!-- Main Outer Pill Container (Morphed smoothly via GPU composition) -->
        <Border x:Name="MainContainer"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0"
                Background="{StaticResource OverlayBackgroundBrush}"
                BorderBrush="{StaticResource OverlayBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource BarCornerRadius}"
                Padding="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MainContainerTransform" Y="0" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============================================================ -->
                <!-- ============================================================ -->
                <!-- 1. Header Bar: Always visible in both Idle & Expanded states -->
                <!-- Dynamic Island Live Activities: Idle, Media, Timer, Notification -->
                <!-- ============================================================ -->
                <Grid x:Name="HeaderBarGrid"
                      Grid.Row="0"
                      Height="44"
                      VerticalAlignment="Top"
                      Padding="14,0,14,0"
                      Background="Transparent"
                      Tapped="OnHeaderBarTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Live Activities or Module Pill Chip -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- 1. Idle Activity Panel (Default when idle) -->
                        <StackPanel x:Name="LiveActivityIdlePanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="Visible">
                            <Ellipse Width="7" Height="7"
                                     Fill="{StaticResource OverlayAccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveActivityDateText"
                                       Text="DynamicTopBar"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 2. Media Live Activity Panel (Album art + Track & Artist ticker) -->
                        <StackPanel x:Name="LiveActivityMediaPanel"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border x:Name="LiveActivityAlbumArtBorder"
                                    Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#1A1A1A"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon x:Name="LiveActivityDefaultMusicIcon"
                                              Glyph="&#xE8D6;"
                                              FontSize="11"
                                              Foreground="{StaticResource OverlayAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    <Image x:Name="LiveActivityAlbumArtImage"
                                           Width="24"
                                           Height="24"
                                           Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" MaxWidth="155">
                                <TextBlock x:Name="LiveActivityTrackText"
                                           Text="Playing Music"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LiveActivityArtistText"
                                           Text="Artist"
                                           FontSize="9.5"
                                           Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. Focus Timer Live Activity Panel (Timer icon + countdown) -->
                        <StackPanel x:Name="LiveActivityTimerPanel"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#2E1C06" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock x:Name="LiveActivityTimerCountdownText"
                                           Text="25:00"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#F59E0B"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveActivityTimerStateText"
                                           Text="Focus"
                                           FontSize="9"
                                           Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. Notification Capsule Pill (Visible when active notification exists) -->
                        <Border x:Name="NotificationCapsulePill"
                                Height="26"
                                CornerRadius="{StaticResource ChipCornerRadius}"
                                Background="#2A1B0E"
                                BorderBrush="#EAB308"
                                BorderThickness="1"
                                Padding="8,0,6,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                PointerPressed="OnNotificationCapsulePillPointerPressed"
                                ToolTipService.ToolTip="Klik untuk melihat detail notifikasi">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEA8F;" FontSize="10" Foreground="#EAB308" />
                                <TextBlock x:Name="NotificationCapsuleText"
                                           Text="Notification"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                           MaxWidth="140"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button x:Name="NotificationDismissButton"
                                        Width="16" Height="16" MinWidth="0" MinHeight="0" Padding="0"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        PointerPressed="OnNotificationDismissButtonPointerPressed"
                                        Click="OnNotificationDismissButtonClick"
                                        ToolTipService.ToolTip="Tutup Notifikasi">
                                    <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 5. App Source Pill Chip [ ⊞ Apps ⌵ ] (Clickable Dropdown Trigger) -->
                        <Border x:Name="AppSourcePillBorder"
                                Height="28"
                                CornerRadius="{StaticResource ChipCornerRadius}"
                                Background="{StaticResource OverlaySurfaceBrush}"
                                BorderBrush="{StaticResource OverlayBorderBrush}"
                                BorderThickness="1"
                                Padding="9,0,9,0"
                                VerticalAlignment="Center"
                                Visibility="Visible"
                                Tapped="OnAppSourcePillTapped"
                                ToolTipService.ToolTip="Buka / Tutup Dropdown Apps">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="AppSourceIcon"
                                          Glyph="&#xEA86;"
                                          FontSize="11"
                                          Foreground="{StaticResource OverlayAccentBrush}" />
                                <TextBlock x:Name="AppSourceText"
                                           Text="Apps"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <FontIcon x:Name="AppChevronIcon"
                                          Glyph="&#xE70D;"
                                          FontSize="9"
                                          Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Equalizer Visualizer + System Status Glyphs + Clock + Pin + Collapse -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Live Activity: 3-bar Audio Equalizer Wave Visualizer -->
                        <StackPanel x:Name="LiveActivityWaveVisualizer"
                                    Orientation="Horizontal"
                                    Spacing="2.5"
                                    VerticalAlignment="Center"
                                    Margin="0,0,2,0"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="Audio sedang berputar">
                            <Border x:Name="WaveBar1" Width="3" Height="14" CornerRadius="1.5" Background="#1DB954" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="WaveBar1Transform" CenterY="7" ScaleY="0.4" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="WaveBar2" Width="3" Height="14" CornerRadius="1.5" Background="#1DB954" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="WaveBar2Transform" CenterY="7" ScaleY="0.8" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="WaveBar3" Width="3" Height="14" CornerRadius="1.5" Background="#1DB954" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="WaveBar3Transform" CenterY="7" ScaleY="0.5" />
                                </Border.RenderTransform>
                            </Border>
                        </StackPanel>

                        <!-- System Status Glyphs -->
                        <StackPanel x:Name="SystemStatusGlyphsPanel"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    VerticalAlignment="Center">
                            <!-- Wi-Fi Status Glyph -->
                            <FontIcon Glyph="&#xE701;"
                                      FontSize="11.5"
                                      Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                      ToolTipService.ToolTip="Wi-Fi Terhubung"
                                      AutomationProperties.Name="Wi-Fi Connected" />

                            <!-- Volume Status Glyph -->
                            <FontIcon Glyph="&#xE767;"
                                      FontSize="11.5"
                                      Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                      ToolTipService.ToolTip="Audio Output"
                                      AutomationProperties.Name="Audio Output" />

                            <!-- Battery Status Glyph -->
                            <FontIcon Glyph="&#xE83F;"
                                      FontSize="12"
                                      Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                      ToolTipService.ToolTip="Status Baterai &amp; Daya"
                                      AutomationProperties.Name="Battery Status" />
                        </StackPanel>

                        <!-- Realtime System Clock -->
                        <TextBlock x:Name="ClockText"
                                   Text="10:24 PM"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />

                        <!-- Pin / Auto-Hide Mode Toggle Button -->
                        <Button x:Name="PinButton"
                                Width="22"
                                Height="22"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnPinButtonClick"
                                ToolTipService.ToolTip="Mode: Sembunyi Otomatis (Klik untuk Sematkan di Layar)"
                                AutomationProperties.Name="Toggle Pin Mode">
                            <FontIcon x:Name="PinIcon"
                                      Glyph="&#xE718;"
                                      FontSize="11"
                                      Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                        </Button>

                        <!-- Explicit Dropdown / Collapse Button (Visible on far right) -->
                        <Button x:Name="CollapseButton"
                                Width="22"
                                Height="22"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="Visible"
                                Click="OnCollapseButtonClick"
                                ToolTipService.ToolTip="Buka / Tutup Dropdown Apps"
                                AutomationProperties.Name="Toggle Dropdown Apps">
                            <FontIcon x:Name="CollapseChevronIcon"
                                      Glyph="&#xE70D;"
                                      FontSize="10"
                                      Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- 2. Expanded Media Panel (Grows downwards from Header)         -->
                <!-- ============================================================ -->
                <Grid x:Name="ExpandedPanelGrid"
                      Grid.Row="1"
                      Margin="16,0,16,14"
                      VerticalAlignment="Stretch"
                      Visibility="Collapsed"
                      Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ExpandedPanelTransform" Y="-8" />
                    </Grid.RenderTransform>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sub-Header: Modular Feature Navigation (Row 0) -->
                    <Grid Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Active Feature Identity (Icon + Name) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,6,0">
                            <FontIcon x:Name="ActiveFeatureIcon"
                                      Glyph="&#xE8D6;"
                                      FontSize="11"
                                      Foreground="{StaticResource OverlayAccentBrush}" />
                            <TextBlock x:Name="ActiveFeatureNameText"
                                       Text="Media Player"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Center: Quick Module Switcher Dock -->
                        <ScrollViewer Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <StackPanel x:Name="ModuleSwitcherDock"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                        </ScrollViewer>

                        <!-- Right: Previous / Next Navigation & Page Indicator & Preferences Gear -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                            <!-- Nav Arrows & Indicator (Hidden if <= 1 feature available) -->
                            <StackPanel x:Name="NavigationControlsPanel"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <Button x:Name="NavPreviousButton"
                                        Width="20"
                                        Height="20"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="10"
                                        Click="OnNavPreviousButtonClick"
                                        ToolTipService.ToolTip="Previous feature (Left arrow)"
                                        AutomationProperties.Name="Previous feature">
                                    <FontIcon Glyph="&#xE72B;"
                                              FontSize="9"
                                              Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                </Button>

                                <TextBlock x:Name="NavPageIndicatorText"
                                           Text="1 / 5"
                                           FontSize="9"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,2,0" />

                                <Button x:Name="NavNextButton"
                                        Width="20"
                                        Height="20"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="10"
                                        Click="OnNavNextButtonClick"
                                        ToolTipService.ToolTip="Next feature (Right arrow)"
                                        AutomationProperties.Name="Next feature">
                                    <FontIcon Glyph="&#xE72A;"
                                              FontSize="9"
                                              Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Settings / Preferences Gear Button -->
                            <Button x:Name="NavSettingsButton"
                                    Width="20"
                                    Height="20"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    Click="OnNavSettingsButtonClick"
                                    ToolTipService.ToolTip="Settings &amp; Personalization"
                                    AutomationProperties.Name="Settings">
                                <FontIcon x:Name="NavSettingsIcon"
                                          Glyph="&#xE713;"
                                          FontSize="10"
                                          Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Content Area (Row 1): Hosts Active Feature Content -->
                    <Grid Grid.Row="1" VerticalAlignment="Stretch">

                        <!-- Feature 1: Media Player Content Host -->
                        <Grid x:Name="MediaContentHost" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Section A: Track Metadata & Album Artwork -->
                            <Grid Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Square Album Artwork with Rounded Corners -->
                                <Border Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="{StaticResource AlbumArtCornerRadius}"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,10,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="ArtworkImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed" />
                                        <FontIcon x:Name="ArtworkFallbackIcon"
                                                  Glyph="&#xE8D6;"
                                                  FontSize="22"
                                                  Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Song Title & Artist Name -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="TrackTitleText"
                                               Text="No media playing"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock x:Name="TrackArtistText"
                                               Text="Play audio in any app"
                                               FontSize="11"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>
                            </Grid>

                            <!-- Section B: Progress Bar & Timestamps (Visible only when valid) -->
                            <StackPanel x:Name="ProgressContainer"
                                        Grid.Row="1"
                                        Margin="0,0,0,6"
                                        Spacing="3"
                                        Visibility="Collapsed">
                                <ProgressBar x:Name="TrackProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Height="3"
                                             CornerRadius="1.5"
                                             Foreground="{StaticResource OverlayAccentBrush}"
                                             Background="{StaticResource OverlayProgressBackgroundBrush}" />
                                <Grid>
                                    <TextBlock x:Name="PositionText"
                                               Text="0:00"
                                               FontSize="10"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="DurationText"
                                               Text="0:00"
                                               FontSize="10"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Section C: Action & Playback Controls Row -->
                            <Grid Grid.Row="2" Margin="0,2,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Favorite / Star Toggle Button -->
                                <Button x:Name="FavoriteButton"
                                        Grid.Column="0"
                                        Width="30"
                                        Height="30"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnFavoriteButtonClick"
                                        ToolTipService.ToolTip="Favorite Track"
                                        AutomationProperties.Name="Favorite Track">
                                    <FontIcon x:Name="FavoriteIcon"
                                              Glyph="&#xE734;"
                                              FontSize="14"
                                              Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                </Button>

                                <!-- Center Playback Controls -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="16">
                                    <!-- Previous Track Button -->
                                    <Button x:Name="PreviousButton"
                                            Width="32"
                                            Height="32"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnPreviousButtonClick"
                                            ToolTipService.ToolTip="Previous Track"
                                            AutomationProperties.Name="Previous Track">
                                        <FontIcon Glyph="&#xE892;"
                                                  FontSize="14"
                                                  Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    </Button>

                                    <!-- Play/Pause Toggle Button (Circular High-Contrast Button) -->
                                    <Button x:Name="PlayPauseButton"
                                            Width="36"
