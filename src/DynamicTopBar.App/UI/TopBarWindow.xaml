                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Click="OnQuickLaunchBrowserClick"
                                        ToolTipService.ToolTip="Open Web Browser"
                                        AutomationProperties.Name="Open Web Browser">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Browser" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 3: Terminal -->
                                <Button Grid.Row="0" Grid.Column="2"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="4,0,0,4" Padding="8,6,8,6"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Click="OnQuickLaunchTerminalClick"
                                        ToolTipService.ToolTip="Open Terminal / Prompt"
                                        AutomationProperties.Name="Open Terminal">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Terminal" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 4: Calculator -->
                                <Button Grid.Row="1" Grid.Column="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0,2,4,0" Padding="8,6,8,6"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Click="OnQuickLaunchCalculatorClick"
                                        ToolTipService.ToolTip="Open Calculator"
                                        AutomationProperties.Name="Open Calculator">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8EF;" FontSize="13" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Calculator" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 5: Settings -->
                                <Button Grid.Row="1" Grid.Column="1"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="2,2,2,0" Padding="8,6,8,6"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Click="OnQuickLaunchSettingsClick"
                                        ToolTipService.ToolTip="Open Windows Settings"
                                        AutomationProperties.Name="Open Windows Settings">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Settings" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 6: Task Manager -->
                                <Button Grid.Row="1" Grid.Column="2"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="4,2,0,0" Padding="8,6,8,6"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Click="OnQuickLaunchTaskMgrClick"
                                        ToolTipService.ToolTip="Open Task Manager"
                                        AutomationProperties.Name="Open Task Manager">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Task Mgr" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Status text at bottom -->
                            <TextBlock x:Name="QuickLaunchStatusText"
                                       Grid.Row="1"
                                       Text="Instant shortcut launcher"
                                       FontSize="10"
                                       Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </Grid>

                        <!-- Feature 4: System Glance (Fully Functional MVP Module) -->
                        <Grid x:Name="SystemGlanceContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tile 1: Date & Time Card -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Margin="0,0,3,3"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6,8,6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Time &amp; Date" FontSize="9" Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="GlanceTimeText"
                                               Text="10:35 AM"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    <TextBlock x:Name="GlanceDateText"
                                               Text="Mon, Oct 19"
                                               FontSize="9"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Tile 2: Battery / Power Status Card -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    Margin="3,0,0,3"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6,8,6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="GlanceBatteryIcon"
                                                  Glyph="&#xE83F;"
                                                  FontSize="11"
                                                  Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Battery / Power" FontSize="9" Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="GlanceBatteryText"
                                               Text="AC Power"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="GlancePowerSupplyText"
                                               Text="Desktop (No Bat)"
                                               FontSize="9"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Tile 3: Network Status Card -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Margin="0,3,3,0"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6,8,6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="GlanceNetworkIcon" Glyph="&#xE701;" FontSize="11" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Network" FontSize="9" Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="GlanceNetworkNameText"
                                               Text="Connected"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="GlanceNetworkTypeText"
                                               Text="Internet Access"
                                               FontSize="9"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Tile 4: Machine & OS Status Card -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Margin="3,3,0,0"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6,8,6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE770;" FontSize="11" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Device &amp; Uptime" FontSize="9" Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="GlanceDeviceNameText"
                                               Text="PC Name"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="GlanceUptimeText"
                                               Text="Uptime: 2h 45m"
                                               FontSize="9"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Feature 5: Stopwatch & Laps (Fully Functional Optional Module) -->
                        <Grid x:Name="StopwatchContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Digital Readout & Actions -->
                            <Grid Grid.Row="0" Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="StopwatchElapsedText"
                                               Text="00:00.0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                               VerticalAlignment="Center" />

                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <Border x:Name="StopwatchModeBadge"
                                                Background="{StaticResource OverlaySurfaceBrush}"
                                                BorderBrush="{StaticResource OverlayBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="6,2,6,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="StopwatchStatusText"
                                                       Text="Ready"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource OverlayAccentBrush}" />
