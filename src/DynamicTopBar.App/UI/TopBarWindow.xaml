                        <Grid x:Name="ClockContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Digital Clock Readout -->
                            <Grid Grid.Row="0" Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClockLargeTimeText"
                                               Text="10:24:00 AM"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                               VerticalAlignment="Center" />

                                    <Border Background="{StaticResource OverlaySurfaceBrush}"
                                            BorderBrush="{StaticResource OverlayBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="6,2,6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="ClockDayOfWeekText"
                                                   Text="Monday"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource OverlayAccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="ClockTzAbbrText"
                                           Grid.Column="1"
                                           Text="LOCAL"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Row 1: Full Date & Windows Timezone Card -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8,10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Date Row -->
                                    <FontIcon Grid.Row="0" Grid.Column="0"
                                              Glyph="&#xE787;"
                                              FontSize="12"
                                              Foreground="{StaticResource OverlayAccentBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,4" />
                                    <TextBlock x:Name="ClockFullDateText"
                                               Grid.Row="0" Grid.Column="1"
                                               Text="October 19, 2026"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,4" />

                                    <!-- Timezone Row -->
                                    <FontIcon Grid.Row="1" Grid.Column="0"
                                              Glyph="&#xE774;"
                                              FontSize="12"
                                              Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <TextBlock x:Name="ClockTimeZoneNameText"
                                               Grid.Row="1" Grid.Column="1"
                                               Text="UTC+08:00 (Central Indonesia Time)"
                                               FontSize="10"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Feature: Spotify Web API & OAuth PKCE (Optional Direct Integration) -->
                        <Grid x:Name="SpotifyContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <!-- State 1: Disconnected / Auth Prompt -->
                            <Grid x:Name="SpotifyDisconnectedPanel" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="Connect Spotify (Web API + PKCE)"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    <TextBlock Text="Optional direct integration. Dev Mode limit: 5 users &amp; Premium account."
                                               FontSize="9"
                                               Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBox x:Name="SpotifyClientIdTextBox"
                                             PlaceholderText="Spotify Client ID (developer.spotify.com)"
                                             FontSize="10"
                                             Height="26"
                                             Padding="6,2,6,2"
                                             Background="{StaticResource OverlaySurfaceBrush}"
                                             BorderBrush="{StaticResource OverlayBorderBrush}"
                                             Foreground="{StaticResource OverlayTextPrimaryBrush}" />

                                    <Button x:Name="SpotifyConnectButton"
                                            Content="Authorize with PKCE"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Padding="12,4,12,4"
                                            Background="{StaticResource OverlayAccentBrush}"
                                            Foreground="#090909"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            HorizontalAlignment="Left"
                                            Click="OnSpotifyConnectButtonClick" />
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Text="Note: Windows Media Player module controls desktop Spotify without API setup."
                                           FontSize="9"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- State 2: Authenticated / Playing -->
                            <Grid x:Name="SpotifyConnectedPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- User Profile & Disconnect -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="SpotifyUserNameText"
                                                   Text="Spotify User"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                        <Border Background="{StaticResource OverlaySurfaceBrush}"
                                                BorderBrush="{StaticResource OverlayBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4,1,4,1">
                                            <TextBlock x:Name="SpotifyProductText"
                                                       Text="Premium"
                                                       FontSize="8"
                                                       Foreground="{StaticResource OverlayAccentBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Disconnect"
                                            FontSize="9"
                                            Padding="5,1,5,1"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource OverlayBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                            Click="OnSpotifyDisconnectButtonClick" />
                                </Grid>

                                <!-- Track & Playback Info -->
                                <Border Grid.Row="1"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8,5,8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="SpotifyTrackTitleText"
                                                       Text="No active track"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="SpotifyTrackArtistText"
                                                       Text="Play music on any Spotify device"
                                                       FontSize="9"
                                                       Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock x:Name="SpotifyDeviceText"
                                                           Text=""
                                                           FontSize="8"
                                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Button x:Name="SpotifyDevicesButton"
                                                        Content="Switch"
                                                        FontSize="7"
                                                        Padding="4,1,4,1"
                                                        Height="16"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Background="Transparent"
                                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Foreground="{StaticResource OverlayAccentBrush}"
                                                        Visibility="Collapsed"
                                                        Click="OnSpotifyDevicesButtonClick" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <Button Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="13" Click="OnSpotifyPrevButtonClick" ToolTipService.ToolTip="Previous">
                                                <FontIcon Glyph="&#xE892;" FontSize="10" Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                            </Button>
                                            <Button x:Name="SpotifyPlayPauseButton" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="{StaticResource OverlayTextPrimaryBrush}" BorderThickness="0" CornerRadius="14" Click="OnSpotifyPlayPauseButtonClick" ToolTipService.ToolTip="Play/Pause">
                                                <FontIcon x:Name="SpotifyPlayPauseIcon" Glyph="&#xE768;" FontSize="11" Foreground="{StaticResource OverlayBackgroundBrush}" />
                                            </Button>
                                            <Button Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="13" Click="OnSpotifyNextButtonClick" ToolTipService.ToolTip="Next">
                                                <FontIcon Glyph="&#xE893;" FontSize="10" Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Status / Notice -->
                                <TextBlock x:Name="SpotifyStatusNoticeText"
                                           Grid.Row="2"
                                           Text=""
                                           FontSize="8"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>

                        <!-- Feature: Weather (Open-Meteo Integration) -->
                        <Grid x:Name="WeatherContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Row: City Search & Refresh -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="WeatherSearchBox"
                                         Grid.Column="0"
                                         PlaceholderText="Search city (e.g. Jakarta, Tokyo)"
                                         FontSize="10"
                                         Height="26"
                                         Padding="6,2,6,2"
                                         Background="{StaticResource OverlaySurfaceBrush}"
                                         BorderBrush="{StaticResource OverlayBorderBrush}"
                                         Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                         KeyDown="OnWeatherSearchBoxKeyDown" />

                                <Button Grid.Column="1"
                                        Content="Search"
                                        FontSize="10"
                                        Padding="7,2,7,2"
                                        Margin="4,0,0,0"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Click="OnWeatherSearchButtonClick" />

                                <Button Grid.Column="2"
                                        Width="26" Height="26"
                                        MinWidth="0" MinHeight="0"
                                        Padding="0"
                                        Margin="3,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="13"
                                        Click="OnWeatherRefreshButtonClick"
                                        ToolTipService.ToolTip="Refresh Weather">
                                    <FontIcon Glyph="&#xE72C;" FontSize="10" Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Search Results List -->
                            <Border x:Name="WeatherSearchResultsBorder"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="WeatherSearchResultsPanel" Spacing="2" />
                                </ScrollViewer>
                            </Border>

                            <!-- Main Weather Card -->
                            <Border x:Name="WeatherMainCard"
                                    Grid.Row="1"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6,10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Current Temperature & Condition -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon x:Name="WeatherConditionGlyph"
                                                      Glyph="&#xE706;"
                                                      FontSize="20"
                                                      Foreground="{StaticResource OverlayAccentBrush}" />
                                            <TextBlock x:Name="WeatherTemperatureText"
                                                       Text="--°C"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                        </StackPanel>

                                        <TextBlock x:Name="WeatherCityText"
                                                   Text="Jakarta, Indonesia"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock x:Name="WeatherConditionText"
                                                   Text="Sunny"
                                                   FontSize="9"
                                                   Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Right: Details & 3-Day Forecast Strip -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <TextBlock x:Name="WeatherHumidityText"
                                                       Text="Humidity: 70%"
                                                       FontSize="9"
                                                       Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                                            <TextBlock x:Name="WeatherPrecipText"
                                                       Text="Rain: 0mm"
                                                       FontSize="9"
                                                       Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                                        </StackPanel>

                                        <!-- Forecast strip -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="WeatherDay1Name" Text="Tue" FontSize="8" Foreground="{StaticResource OverlayTextTertiaryBrush}" HorizontalAlignment="Center" />
                                                <FontIcon x:Name="WeatherDay1Glyph" Glyph="&#xE706;" FontSize="9" Foreground="{StaticResource OverlayAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="WeatherDay1Temp" Text="32°" FontSize="8" Foreground="{StaticResource OverlayTextSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="WeatherDay2Name" Text="Wed" FontSize="8" Foreground="{StaticResource OverlayTextTertiaryBrush}" HorizontalAlignment="Center" />
                                                <FontIcon x:Name="WeatherDay2Glyph" Glyph="&#xE708;" FontSize="9" Foreground="{StaticResource OverlayAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="WeatherDay2Temp" Text="31°" FontSize="8" Foreground="{StaticResource OverlayTextSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="WeatherDay3Name" Text="Thu" FontSize="8" Foreground="{StaticResource OverlayTextTertiaryBrush}" HorizontalAlignment="Center" />
                                                <FontIcon x:Name="WeatherDay3Glyph" Glyph="&#xE774;" FontSize="9" Foreground="{StaticResource OverlayAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="WeatherDay3Temp" Text="29°" FontSize="8" Foreground="{StaticResource OverlayTextSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Status Row: Attribution & Offline Notice -->
                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WeatherLastUpdatedText"
                                           Grid.Column="0"
                                           Text="Updated: Just now"
                                           FontSize="8"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="Data: Open-Meteo"
                                           FontSize="8"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                            </Grid>
                        </Grid>

                        <!-- Feature: To-do List (Task CRUD & Local Persistence) -->
                        <Grid x:Name="TodoContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Quick Add Input + Priority + Add Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TodoNewTaskBox"
                                         Grid.Column="0"
                                         PlaceholderText="Add a new task..."
                                         FontSize="10"
                                         Height="26"
                                         Padding="6,2,6,2"
                                         Background="{StaticResource OverlaySurfaceBrush}"
                                         BorderBrush="{StaticResource OverlayBorderBrush}"
                                         Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                         KeyDown="OnTodoNewTaskBoxKeyDown" />

                                <ComboBox x:Name="TodoPriorityComboBox"
                                          Grid.Column="1"
                                          Height="26"
                                          FontSize="9"
                                          Margin="3,0,0,0"
                                          Background="{StaticResource OverlaySurfaceBrush}"
                                          BorderBrush="{StaticResource OverlayBorderBrush}"
                                          SelectedIndex="1">
                                    <ComboBoxItem Content="Low" />
                                    <ComboBoxItem Content="Normal" />
                                    <ComboBoxItem Content="High" />
                                </ComboBox>

                                <Button Grid.Column="2"
                                        Content="Add"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Padding="8,2,8,2"
                                        Margin="3,0,0,0"
                                        Background="{StaticResource OverlayAccentBrush}"
                                        Foreground="#090909"
                                        BorderThickness="0"
                                        CornerRadius="5"
                                        Click="OnTodoAddButtonClick" />
                            </Grid>

                            <!-- Row 1: Task Checklist ScrollViewer -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,4,6,4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TodoListContainer" Spacing="3">
                                        <TextBlock x:Name="TodoEmptyNotice"
                                                   Text="No tasks. Add one above to stay organized."
                                                   FontSize="10"
                                                   Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,14,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Row 2: Status & Clear Completed -->
                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TodoSummaryText"
                                           Grid.Column="0"
                                           Text="0 active tasks"
                                           FontSize="9"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Content="Clear Done"
                                        FontSize="8"
                                        Padding="5,1,5,1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                        Click="OnTodoClearDoneButtonClick" />
                            </Grid>
                        </Grid>

                        <!-- Feature: Calendar & Upcoming Events -->
                        <Grid x:Name="CalendarContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="6,2,6,2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE787;" FontSize="9" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock x:Name="CalendarNextCountdownText"
                                                   Text="No upcoming events"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Button x:Name="CalendarAddEventButton"
                                        Grid.Column="1"
                                        Content="+ Event"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Padding="6,2,6,2"
                                        Margin="3,0,0,0"
                                        Background="{StaticResource OverlayAccentBrush}"
                                        Foreground="#090909"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Click="OnCalendarAddEventButtonClick" />

                                <Button x:Name="CalendarImportIcsButton"
                                        Grid.Column="2"
                                        Content="Import ICS"
                                        FontSize="9"
                                        Padding="6,2,6,2"
                                        Margin="3,0,0,0"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                        Click="OnCalendarImportIcsButtonClick" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,4,6,4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CalendarEventsContainer" Spacing="3">
                                        <TextBlock x:Name="CalendarEmptyNotice"
                                                   Text="No scheduled events. Click '+ Event' or import .ics to add."
                                                   FontSize="10"
                                                   Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,14,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CalendarSummaryText"
                                           Grid.Column="0"
                                           Text="0 events today"
                                           FontSize="9"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Content="Export .ICS"
                                        FontSize="8"
                                        Padding="5,1,5,1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                        Click="OnCalendarExportIcsButtonClick" />
                            </Grid>
                        </Grid>

                        <!-- Feature: Quick Notes -->
                        <Grid x:Name="NotesContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="NoteTitleBox"
                                         Grid.Column="0"
                                         PlaceholderText="Note Title..."
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Height="26"
                                         Padding="6,2,6,2"
                                         Background="{StaticResource OverlaySurfaceBrush}"
                                         BorderBrush="{StaticResource OverlayBorderBrush}"
                                         Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                         TextChanged="OnNoteTitleChanged" />

                                <Button x:Name="NotePinButton"
                                        Grid.Column="1"
                                        Width="26" Height="26"
                                        MinWidth="0" MinHeight="0"
                                        Padding="0"
                                        Margin="3,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="13"
                                        Click="OnNotePinButtonClick"
                                        ToolTipService.ToolTip="Pin note to top">
                                    <FontIcon x:Name="NotePinIcon" Glyph="&#xE718;" FontSize="11" Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                </Button>

                                <Button x:Name="NoteNewButton"
                                        Grid.Column="2"
                                        Content="+ New"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Padding="7,2,7,2"
                                        Margin="3,0,0,0"
                                        Background="{StaticResource OverlayAccentBrush}"
                                        Foreground="#090909"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Click="OnNoteNewButtonClick" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2">
                                <TextBox x:Name="NoteContentBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         PlaceholderText="Type your quick note or scratchpad thoughts here..."
                                         FontSize="11"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                         VerticalAlignment="Stretch"
                                         TextChanged="OnNoteContentChanged" />
                            </Border>

                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="NoteStatusText"
                                           Grid.Column="0"
                                           Text="Autosaved locally"
                                           FontSize="8"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           VerticalAlignment="Center" />

                                <Button x:Name="NotePrevBtn"
                                        Grid.Column="1"
                                        Content="Notes List"
                                        FontSize="8"
                                        Padding="5,1,5,1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                        Click="OnNoteCycleListClick" />

                                <Button x:Name="NoteDeleteButton"
                                        Grid.Column="2"
                                        Content="Delete"
                                        FontSize="8"
                                        Padding="5,1,5,1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                        Click="OnNoteDeleteButtonClick" />
                            </Grid>
                        </Grid>

                        <!-- Feature: Clipboard History (Strict Opt-In Privacy) -->
                        <Grid x:Name="ClipboardContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid x:Name="ClipboardOptInPanel" Visibility="Visible">
                                <Border Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8,12,8">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{StaticResource OverlayAccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Clipboard Privacy Gate" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OverlayTextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Clipboard capture is disabled by default. Text snippets remain strictly on this PC without any network transmission."
                                                   FontSize="9" Foreground="{StaticResource OverlayTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="8,0,8,4" />
                                        <Button Content="Enable Clipboard (Opt-In)"
                                                FontSize="9" FontWeight="SemiBold"
                                                Padding="10,3,10,3"
                                                Background="{StaticResource OverlayAccentBrush}"
                                                Foreground="#090909"
                                                BorderThickness="0"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center"
                                                Click="OnClipboardEnableOptInClick" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="ClipboardActivePanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ClipboardStatusText"
                                               Grid.Column="0"
                                               Text="Monitoring (0 saved)"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayAccentBrush}"
                                               VerticalAlignment="Center" />

                                    <Button x:Name="ClipboardPauseButton"
                                            Grid.Column="1"
                                            Content="Pause"
                                            FontSize="8"
                                            Padding="6,1,6,1"
                                            Background="{StaticResource OverlaySurfaceBrush}"
                                            BorderBrush="{StaticResource OverlayBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                            Click="OnClipboardPauseToggleClick" />

                                    <Button Grid.Column="2"
                                            Content="Clear"
                                            FontSize="8"
                                            Padding="6,1,6,1"
                                            Margin="3,0,0,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                            Click="OnClipboardClearHistoryClick" />
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6,4,6,4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="ClipboardSnippetsContainer" Spacing="2">
                                            <TextBlock x:Name="ClipboardEmptyNotice"
                                                       Text="No snippets copied yet. Copy text anywhere in Windows."
                                                       FontSize="10"
                                                       Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,14,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Grid.Row="2"
                                           Text="Click snippet to copy back. Local memory only."
                                           FontSize="8"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           Margin="0,3,0,0" />
                            </Grid>
                        </Grid>

                        <!-- 12. Universal Tools Engine Content Host -->
                        <Grid x:Name="ToolsContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Category Selector Chips & Quick Action -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="ToolCategoryDevBtn" Content="Developer" FontSize="9" FontWeight="SemiBold" Height="22" Padding="6,1,6,1" CornerRadius="11" Background="{StaticResource OverlayAccentBrush}" Foreground="#090909" Click="OnToolCategoryDevClick" />
                                    <Button x:Name="ToolCategoryFileBtn" Content="File Tools" FontSize="9" FontWeight="SemiBold" Height="22" Padding="6,1,6,1" CornerRadius="11" Background="{StaticResource OverlaySurfaceBrush}" Foreground="{StaticResource OverlayTextSecondaryBrush}" Click="OnToolCategoryFileClick" />
                                    <Button x:Name="ToolCategoryImageBtn" Content="Image Tools" FontSize="9" FontWeight="SemiBold" Height="22" Padding="6,1,6,1" CornerRadius="11" Background="{StaticResource OverlaySurfaceBrush}" Foreground="{StaticResource OverlayTextSecondaryBrush}" Click="OnToolCategoryImageClick" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="ToolExecuteBtn" Content="Execute" FontSize="10" FontWeight="SemiBold" Height="22" Padding="8,1,8,1" CornerRadius="6" Background="{StaticResource OverlayAccentBrush}" Foreground="#090909" Click="OnToolExecuteClick" />
                                    <Button x:Name="ToolPopOutBtn" Content="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Height="22" Width="24" Padding="0" CornerRadius="6" Background="{StaticResource OverlaySurfaceBrush}" Foreground="{StaticResource OverlayTextPrimaryBrush}" Click="OnToolOpenWorkspaceClick" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Active Tool Selector Dropdown / Chips -->
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                    <StackPanel x:Name="ToolSelectorChipsPanel" Orientation="Horizontal" Spacing="4" />
                                </ScrollViewer>
                            </Grid>

                            <!-- Row 2: Tool Input Area -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="ToolInputBox"
                                             PlaceholderText="Input text, JSON, regex, or file paths..."
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontSize="10"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    <TextBlock x:Name="ToolOutputSnippetText"
                                               Grid.Row="1"
                                               FontSize="9"
                                               Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                               Margin="0,4,0,0"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <!-- Row 3: Result status bar -->
                            <Grid Grid.Row="3" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ToolStatusText"
                                           Text="Ready. Select tool and press Execute."
                                           FontSize="9"
                                           Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button x:Name="ToolCopyResultBtn"
                                        Grid.Column="1"
                                        Content="Copy Result"
                                        FontSize="8"
                                        Height="18"
                                        Padding="5,0,5,0"
                                        CornerRadius="4"
                                        Background="{StaticResource OverlayControlHoverBrush}"
                                        Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                        Click="OnToolCopyResultClick" />
                            </Grid>
                        </Grid>

                        <!-- Reusable Shared Feature Host for Planned Roadmap Modules -->
                        <Grid x:Name="SharedPlaceholderContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Border Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10,12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header Row: Feature Icon + Title + Milestone Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="28" Height="28"
                                                CornerRadius="14"
                                                Background="{StaticResource OverlayBackgroundBrush}"
                                                BorderBrush="{StaticResource OverlayBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,8,0">
                                            <FontIcon x:Name="PlaceholderFeatureIcon"
                                                      Glyph="&#xE71D;"
                                                      FontSize="13"
                                                      Foreground="{StaticResource OverlayAccentBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:Name="PlaceholderFeatureTitle"
                                                       Text="Planned Feature"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                            <TextBlock x:Name="PlaceholderMilestoneText"
                                                       Text="Phase 3 Roadmap"
                                                       FontSize="10"
                                                       Foreground="{StaticResource OverlayAccentBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{StaticResource OverlayBackgroundBrush}"
                                                BorderBrush="{StaticResource OverlayBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="6,2,6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Roadmap"
                                                       FontSize="9"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource OverlayTextTertiaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Middle: Planned Scope Description -->
                                    <TextBlock x:Name="PlaceholderScopeText"
                                               Grid.Row="1"
                                               Text="Feature definition and modular container initialized."
                                               FontSize="11"
                                               Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxLines="3"
                                               VerticalAlignment="Center"
                                               Margin="0,2,0,4" />

                                    <!-- Footer: Dependency & Deliberate State Note -->
                                    <TextBlock x:Name="PlaceholderDependencyText"
                                               Grid.Row="2"
                                               Text="Deliberate placeholder — No fake live data"
                                               FontSize="9"
                                               Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Feature: Command Palette Overlay -->
                        <Grid x:Name="CommandPaletteContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox x:Name="CommandSearchTextBox"
                                     Grid.Row="0"
                                     PlaceholderText="Type command (e.g. spotify, todo, notes, focus)..."
                                     FontSize="11"
                                     Height="28"
                                     Padding="8,2,8,2"
                                     Background="{StaticResource OverlaySurfaceBrush}"
                                     BorderBrush="{StaticResource OverlayBorderBrush}"
                                     Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                     CornerRadius="5"
                                     Margin="0,0,0,6"
                                     TextChanged="OnCommandSearchTextChanged"
                                     KeyDown="OnCommandSearchKeyDown" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="CommandResultsContainer" Spacing="2" />
                            </ScrollViewer>
                        </Grid>

                        <!-- Feature: Productivity Hub Overview -->
                        <Grid x:Name="ProductivityContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource OverlaySurfaceBrush}"
                                    BorderBrush="{StaticResource OverlayBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4,8,4"
                                    Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="11" Foreground="{StaticResource OverlayAccentBrush}" />
                                    <TextBlock x:Name="ProductivitySummaryText"
                                               Text="Productivity Hub Active"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Active Tasks" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                        <TextBlock x:Name="ProductivityTasksPreviewText"
                                                   Text="No active tasks"
                                                   FontSize="9"
                                                   Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Upcoming Schedule" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                        <TextBlock x:Name="ProductivitySchedulePreviewText"
                                                   Text="No upcoming events"
                                                   FontSize="9"
                                                   Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Module Preferences Overlay View (Toggled by Gear Button) -->
                        <Grid x:Name="SettingsContentHost" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Module Settings &amp; Personalization:"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                       Margin="0,0,0,4" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <CheckBox x:Name="PrefMediaCheck" Grid.Row="0" Grid.Column="0" Content="Media Player" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />
                                        <CheckBox x:Name="PrefSpotifyCheck" Grid.Row="0" Grid.Column="1" Content="Spotify" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />

                                        <CheckBox x:Name="PrefClockCheck" Grid.Row="1" Grid.Column="0" Content="Clock &amp; Date" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />
                                        <CheckBox x:Name="PrefWeatherCheck" Grid.Row="1" Grid.Column="1" Content="Weather" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />

                                        <CheckBox x:Name="PrefTodoCheck" Grid.Row="2" Grid.Column="0" Content="To-do List" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />
                                        <CheckBox x:Name="PrefFocusCheck" Grid.Row="2" Grid.Column="1" Content="Focus Timer" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />

                                        <CheckBox x:Name="PrefQuickLaunchCheck" Grid.Row="3" Grid.Column="0" Content="Quick Launch" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />
                                        <CheckBox x:Name="PrefGlanceCheck" Grid.Row="3" Grid.Column="1" Content="System Glance" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />

                                        <CheckBox x:Name="PrefCalendarCheck" Grid.Row="4" Grid.Column="0" Content="Calendar" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />
                                        <CheckBox x:Name="PrefNotesCheck" Grid.Row="4" Grid.Column="1" Content="Quick Notes" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />

                                        <CheckBox x:Name="PrefClipboardCheck" Grid.Row="5" Grid.Column="0" Content="Clipboard" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Margin="0,0,0,1" Click="OnModulePreferenceCheckClick" />
                                    </Grid>

                                    <!-- Personalization Divider -->
                                    <Border Height="1" Background="{StaticResource OverlayBorderBrush}" Margin="0,4,0,4" />
                                    <TextBlock Text="Personalization &amp; Privacy:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OverlayAccentBrush}" />

                                    <CheckBox x:Name="Pref24HourClockCheck" Content="24-Hour Clock Format" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Click="OnPersonalizationSettingChanged" />
                                    <CheckBox x:Name="PrefFahrenheitCheck" Content="Weather in Fahrenheit (°F)" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Click="OnPersonalizationSettingChanged" />
                                    <CheckBox x:Name="PrefRemindersCheck" Content="Reminders for Due Tasks &amp; Events" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Click="OnPersonalizationSettingChanged" />
                                    <CheckBox x:Name="PrefClipboardOptInSettingCheck" Content="Enable Opt-In Clipboard History" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Click="OnPersonalizationSettingChanged" />
                                    <CheckBox x:Name="PrefNotificationPrivacyCheck" Content="Mask Notification Preview (Privacy Mode)" FontSize="10" Foreground="{StaticResource OverlayTextPrimaryBrush}" Click="OnPersonalizationSettingChanged" />

                                    <Button x:Name="ResetShortcutsButton"
                                            Content="Reset Global Shortcuts to Defaults"
                                            FontSize="9"
                                            Padding="8,2,8,2"
                                            Margin="0,2,0,0"
                                            Background="{StaticResource OverlaySurfaceBrush}"
                                            Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                            BorderBrush="{StaticResource OverlayBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Click="OnResetShortcutsClick" />

                                    <Button Content="Clear All Local App Data"
                                            FontSize="9"
                                            Padding="8,2,8,2"
                                            Margin="0,4,0,0"
                                            Background="#2D1515"
                                            Foreground="#FF8888"
                                            BorderBrush="#552222"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Click="OnClearAllAppDataClick" />
                                </StackPanel>
                            </ScrollViewer>

                            <TextBlock Grid.Row="2"
                                       Text="Preferences are saved automatically to local storage."
                                       FontSize="9"
                                       Foreground="{StaticResource OverlayTextTertiaryBrush}"
                                       Margin="0,2,0,0" />
                        </Grid>

                        <!-- Diagnostic Empty View (Displayed when 0 modules are enabled) -->
                        <Grid x:Name="EmptyModulesContentHost" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <FontIcon Glyph="&#xE946;"
                                          FontSize="22"
                                          Foreground="{StaticResource OverlayAccentBrush}"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="No Modules Enabled"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OverlayTextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Enable at least one module in preferences."
                                           FontSize="11"
                                           Foreground="{StaticResource OverlayTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <Button Content="Configure Modules"
                                        FontSize="11"
                                        Padding="12,4,12,4"
                                        Margin="0,6,0,0"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        HorizontalAlignment="Center"
                                        Click="OnNavSettingsButtonClick" />
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
