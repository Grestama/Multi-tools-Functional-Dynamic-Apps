                                                CornerRadius="6"
                                                Padding="6,2,6,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="FocusModeText"
                                                       Text="Work Session"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource OverlayAccentBrush}" />
