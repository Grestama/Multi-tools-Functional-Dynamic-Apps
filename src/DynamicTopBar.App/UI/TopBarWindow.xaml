                                    <Button x:Name="StopwatchLapButton"
                                            Width="30"
                                            Height="30"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="15"
                                            IsEnabled="False"
                                            Click="OnStopwatchLapButtonClick"
                                            ToolTipService.ToolTip="Record Lap"
                                            AutomationProperties.Name="Record Lap">
                                        <FontIcon Glyph="&#xE7C1;"
                                                  FontSize="12"
                                                  Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                    </Button>

                                    <!-- Reset button -->
                                    <Button x:Name="StopwatchResetButton"
                                            Width="30"
                                            Height="30"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="15"
                                            IsEnabled="False"
                                            Click="OnStopwatchResetButtonClick"
                                            ToolTipService.ToolTip="Reset Stopwatch"
                                            AutomationProperties.Name="Reset Stopwatch">
