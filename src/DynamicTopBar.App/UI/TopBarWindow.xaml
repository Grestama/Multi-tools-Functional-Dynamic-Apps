                                            Height="36"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            Background="{StaticResource OverlayTextPrimaryBrush}"
                                            BorderThickness="0"
                                            CornerRadius="18"
                                            Click="OnStopwatchPlayPauseButtonClick"
                                            ToolTipService.ToolTip="Start or Stop Stopwatch"
                                            AutomationProperties.Name="Start or Stop Stopwatch">
                                        <FontIcon x:Name="StopwatchPlayPauseIcon"
                                                  Glyph="&#xE768;"
                                                  FontSize="15"
                                                  Foreground="{StaticResource OverlayBackgroundBrush}" />
