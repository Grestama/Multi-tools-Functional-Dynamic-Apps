                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Tile 1: Explorer -->
                                <Button Grid.Row="0" Grid.Column="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0,0,4,4" Padding="8,6,8,6"
                                        Background="{StaticResource OverlaySurfaceBrush}"
                                        BorderBrush="{StaticResource OverlayBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Click="OnQuickLaunchExplorerClick"
                                        ToolTipService.ToolTip="Open File Explorer"
                                        AutomationProperties.Name="Open File Explorer">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="{StaticResource OverlayAccentBrush}" />
                                        <TextBlock Text="Files" FontSize="11" FontWeight="Medium" Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 2: Browser -->
                                <Button Grid.Row="0" Grid.Column="1"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="2,0,2,4" Padding="8,6,8,6"
