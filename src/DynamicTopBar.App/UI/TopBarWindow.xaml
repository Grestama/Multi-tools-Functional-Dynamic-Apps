                                            MinHeight="0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="15"
                                            Click="OnFocusResetButtonClick"
                                            ToolTipService.ToolTip="Reset Timer"
                                            AutomationProperties.Name="Reset Timer">
                                        <FontIcon Glyph="&#xE777;"
                                                  FontSize="12"
                                                  Foreground="{StaticResource OverlayTextSecondaryBrush}" />
                                    </Button>

                                    <Button x:Name="FocusPlayPauseButton"
                                            Width="36"
                                            Height="36"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            Background="{StaticResource OverlayTextPrimaryBrush}"
                                            BorderThickness="0"
                                            CornerRadius="18"
                                            Click="OnFocusPlayPauseButtonClick"
                                            ToolTipService.ToolTip="Start or Pause Timer"
                                            AutomationProperties.Name="Start or Pause Timer">
                                        <FontIcon x:Name="FocusPlayPauseIcon"
                                                  Glyph="&#xE768;"
                                                  FontSize="15"
                                                  Foreground="{StaticResource OverlayBackgroundBrush}" />
                                    </Button>
                                </StackPanel>
